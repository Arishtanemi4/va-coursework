   "source": [
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def plot_top_loadings(loadings_df, pc_name):\n",
    "    # Sort loadings for the specific Principal Component\n",
    "    sorted_loadings = loadings_df.sort_values(by=pc_name, ascending=False)\n",
    "    \n",
    "    # Get top 5 positive and top 5 negative\n",
    "    top_pos = sorted_loadings.head(5)[pc_name]\n",
    "    top_neg = sorted_loadings.tail(5)[pc_name]\n",
    "    top_combined = pd.concat([top_pos, top_neg])\n",
    "    \n",
    "    # Plot\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    sns.barplot(x=top_combined.values, y=top_combined.index, \n",
    "                hue=top_combined.values > 0, palette={True: 'steelblue', False: 'indianred'}, legend=False)\n",
    "    plt.title(f'Top Driving Features for {pc_name}')\n",
    "    plt.xlabel('Loading Weight (Direction & Strength)')\n",
    "    plt.ylabel('Original Feature')\n",
    "    plt.axvline(0, color='black', linewidth=1)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Plot for PC1 and PC2\n",
    "\n",
    "loadings = pd.read_csv(\"PCA_loadings.csv\")\n",
    "\n",
    "print(\"--- PCA Interpretation ---\")\n",
    "plot_top_loadings(loadings, 'PC1')\n",
    "plot_top_loadings(loadings, 'PC2')\n",
    "\n",
    "\n",
    "component_cols = ['PCA_1', 'PCA_2', 'TSNE_1', 'TSNE_2']\n",
    "\n",
    "correlations = df_model[features + component_cols].corr()\n",
    "\n",
    "comp_correlations = correlations.loc[features, component_cols]\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.heatmap(comp_correlations, annot=True, cmap='coolwarm', center=0, fmt=\".2f\")\n",
    "plt.title(\"Correlation: Original Features vs. Dimensionality Reduction Axes\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n--- t-SNE Interpretation (Top Correlations) ---\")\n",
    "print(\"\\nFeatures most positively correlated with TSNE_1:\")\n",
    "print(comp_correlations['TSNE_1'].sort_values(ascending=False).head(3))\n",
    "\n",
    "print(\"\\nFeatures most negatively correlated with TSNE_1:\")\n",
    "print(comp_correlations['TSNE_1'].sort_values(ascending=True).head(3))\n",
    "\n",
    "print(\"\\nFeatures most positively correlated with TSNE_2:\")\n",
    "print(comp_correlations['TSNE_2'].sort_values(ascending=False).head(3))\n",
    "\n",
    "print(\"\\nFeatures most negatively correlated with TSNE_2:\")\n",
    "print(comp_correlations['TSNE_2'].sort_values(ascending=True).head(3))"
   ]
