   "source": [
    "import pandas as pd\n",
    "from pca import pre_pca_concat\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.manifold import TSNE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e47121b7-4dc2-46d1-b283-44ded4dafc7a",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pre_pca_concat()"
   ]
  },
  {
   "cell_type": "raw",
   "id": "d2df4b1f-eead-402b-9ab7-c4834aa7d784",
   "metadata": {},
   "source": [
    "# build proportion columns without overwriting the raw counts\n",
    "pop_cols = ['eth_white', 'eth_asian', 'eth_black', 'eth_mixed', 'eth_other',\n",
    "            'health_very_good', 'health_good', 'health_fair', 'health_bad', 'health_very_bad']\n",
    "\n",
    "emp_cols = ['occ_managers', 'occ_professionals', 'occ_associate_prof', 'occ_admin',\n",
    "            'occ_skilled_trades', 'occ_caring', 'occ_sales', 'occ_machine_ops', 'occ_elementary']\n",
    "\n",
    "for col in pop_cols:\n",
    "    df_master[col + '_pct'] = df_master[col] / df_master['total_pop']\n",
    "\n",
    "for col in emp_cols:\n",
    "    df_master[col + '_pct'] = df_master[col] / df_master['total_employed']\n",
    "\n",
    "\n",
    "features = [c + '_pct' for c in pop_cols + emp_cols]\n",
    "\n",
    "\n",
    "# missingness and sanity check\n",
    "print(\"missing values per feature:\")\n",
    "print(df_master[features].isna().sum())\n",
    "print(\"rows with any nan:\", df_master[features].isna().any(axis=1).sum())\n",
    "print(\"any negative proportions:\", (df_master[features] < 0).any().any())\n",
    "print(\"any proportions above 1:\", (df_master[features] > 1).any().any())\n",
    "\n",
    "\n",
    "# drop any rows with nans before fitting\n",
    "df_model = df_master.dropna(subset=features).copy()\n",
    "\n",
    "\n",
    "# standardise\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(df_model[features])\n",
    "\n",
    "\n",
    "# pca\n",
    "pca = PCA(n_components=2)\n",
    "pca_components = pca.fit_transform(X_scaled)\n",
    "df_model['PCA_1'] = pca_components[:, 0]\n",
    "df_model['PCA_2'] = pca_components[:, 1]\n",
    "\n",
    "print(\"\\npca explained variance ratio:\", pca.explained_variance_ratio_)\n",
    "print(\"pc1 + pc2 combined:\", pca.explained_variance_ratio_.sum())\n",
    "\n",
    "loadings = pd.DataFrame(pca.components_.T, index=features, columns=['PC1', 'PC2'])\n",
    "print(\"\\nloadings sorted by pc1:\")\n",
    "print(loadings.sort_values('PC1'))\n",
    "\n",
    "\n",
    "# tsne\n",
    "tsne = TSNE(n_components=2, perplexity=30, random_state=42, init='pca')\n",
    "tsne_components = tsne.fit_transform(X_scaled)\n",
    "df_model['TSNE_1'] = tsne_components[:, 0]\n",
    "df_model['TSNE_2'] = tsne_components[:, 1]\n",
    "\n",
    "\n",
    "# save outputs\n",
    "df_model.to_csv('PCA.csv', index=False)\n",
    "loadings.to_csv('PCA_loadings.csv')"
   ]
  },
  {
   "cell_type": "raw",
   "id": "64d03d5b-c731-4f4d-8f44-27341ffb0f96",
   "metadata": {},
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def plot_top_loadings(loadings_df, pc_name):\n",
    "    # Sort loadings for the specific Principal Component\n",
    "    sorted_loadings = loadings_df.sort_values(by=pc_name, ascending=False)\n",
    "    \n",
    "    # Get top 5 positive and top 5 negative\n",
    "    top_pos = sorted_loadings.head(5)[pc_name]\n",
    "    top_neg = sorted_loadings.tail(5)[pc_name]\n",
    "    top_combined = pd.concat([top_pos, top_neg])\n",
    "    \n",
    "    # Plot\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    sns.barplot(x=top_combined.values, y=top_combined.index, \n",
    "                hue=top_combined.values > 0, palette={True: 'steelblue', False: 'indianred'}, legend=False)\n",
    "    plt.title(f'Top Driving Features for {pc_name}')\n",
    "    plt.xlabel('Loading Weight (Direction & Strength)')\n",
    "    plt.ylabel('Original Feature')\n",
    "    plt.axvline(0, color='black', linewidth=1)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Plot for PC1 and PC2\n",
    "\n",
    "loadings = pd.read_csv(\"PCA_loadings.csv\")\n",
    "\n",
    "print(\"--- PCA Interpretation ---\")\n",
    "plot_top_loadings(loadings, 'PC1')\n",
    "plot_top_loadings(loadings, 'PC2')\n",
    "\n",
    "\n",
    "component_cols = ['PCA_1', 'PCA_2', 'TSNE_1', 'TSNE_2']\n",
    "\n",
    "correlations = df_model[features + component_cols].corr()\n",
    "\n",
    "comp_correlations = correlations.loc[features, component_cols]\n",
    "\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.heatmap(comp_correlations, annot=True, cmap='coolwarm', center=0, fmt=\".2f\")\n",
    "plt.title(\"Correlation: Original Features vs. Dimensionality Reduction Axes\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n--- t-SNE Interpretation (Top Correlations) ---\")\n",
    "print(\"\\nFeatures most positively correlated with TSNE_1:\")\n",
    "print(comp_correlations['TSNE_1'].sort_values(ascending=False).head(3))\n",
    "\n",
    "print(\"\\nFeatures most negatively correlated with TSNE_1:\")\n",
    "print(comp_correlations['TSNE_1'].sort_values(ascending=True).head(3))\n",
    "\n",
    "print(\"\\nFeatures most positively correlated with TSNE_2:\")\n",
    "print(comp_correlations['TSNE_2'].sort_values(ascending=False).head(3))\n",
    "\n",
    "print(\"\\nFeatures most negatively correlated with TSNE_2:\")\n",
    "print(comp_correlations['TSNE_2'].sort_values(ascending=True).head(3))"
   ]
  },
